# Duffel Flights API — server-side only, never exposed to the browser.
# Get a token from https://app.duffel.com (Developers > Access tokens).
# Use a test-mode token while developing.
DUFFEL_API_TOKEN=

# Public site URL, used for metadata/Open Graph/sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase/Postgres — optional for local development. Without these, the
# app still runs and flight search works; destination management falls
# back to the static config and price alerts return a 503 until configured.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Basic-auth password protecting /admin. Leave unset to keep /admin closed.
ADMIN_PASSWORD=

# Duffel Links (hosted booking checkout) — see docs/revenue.md. Both of
# these must be set for booking to activate at all; without them, "View
# Deal" always shows "Booking coming soon". Requires a Duffel account
# approved for Duffel Payments — a search-only DUFFEL_API_TOKEN is not
# enough on its own.
DUFFEL_LINKS_ENABLED=
# "test" (default) or "live" — reported verbatim to the UI as a "Test
# Booking" badge or a real booking link. Never infer this from the token.
DUFFEL_LINKS_MODE=test
# Optional decimal markup rate applied by Duffel Links, e.g. 0.05 for 5%.
BOOKING_MARKUP_RATE=

# Where the /contact form's submissions should be reviewed (stored in
# Supabase's contact_messages table, not emailed — no email provider is
# configured yet). Never hardcode a personal email address in source.
CONTACT_EMAIL=
